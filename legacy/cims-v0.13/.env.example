NODE_ENV=development
CIMS_API_PORT=4000
CIMS_DB_PATH=./var/cims-dev.sqlite
CIMS_TOKEN_SECRET=development-only-change-me-at-least-32-characters
CIMS_OTP_MODE=fixed
CIMS_FIXED_OTP=123456
CIMS_EXPOSE_DEVELOPMENT_OTP=true
CIMS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
CIMS_PROVIDER_BASE_URL=http://127.0.0.1:4100
CIMS_PROVIDER_CODE=CIMS-MOCK
CIMS_PROVIDER_WEBHOOK_SECRET=development-only-secret-change-me
CIMS_PARTICIPANT_TOKEN_TTL_MINUTES=30
MOCK_PROVIDER_PORT=4100
MOCK_PROVIDER_WEBHOOK_SECRET=development-only-secret-change-me
CIMS_WEBHOOK_URL=http://127.0.0.1:4000/api/v1/provider-webhooks/video
CIMS_LOGIN_RATE_LIMIT_PER_MINUTE=10
CIMS_PUBLIC_RATE_LIMIT_PER_MINUTE=30
CIMS_ACCOUNT_LOCKOUT_THRESHOLD=5
CIMS_ACCOUNT_LOCKOUT_MINUTES=15
