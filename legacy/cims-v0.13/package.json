{
  "name": "cims-platform",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "api": "node apps/api/src/server.mjs",
    "web": "node tools/static-server.mjs apps/web/app 4173",
    "prototype": "node tools/static-server.mjs apps/web/prototype 4174",
    "mock:provider": "node services/mock-video-provider/src/server.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs && npm run test:provider && npm run test:zoom-adapter",
    "test:core": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:provider": "node tests/contract/provider-smoke.mjs",
    "check": "node tools/repository-check.mjs",
    "reset:db": "node apps/api/src/scripts/reset-db.mjs",
    "demo": "node tools/pilot-uat-0-12.mjs",
    "test:performance": "node tools/performance-smoke-0-12.mjs",
    "test:dr": "node tools/dr-recovery-test-0-12.mjs",
    "test:uat": "node tools/pilot-uat-0-12.mjs",
    "zoom:adapter": "node services/zoom-video-provider/src/server.mjs",
    "fake:zoom": "node services/fake-zoom-api/src/server.mjs",
    "test:zoom-adapter": "node tests/contract/zoom-adapter-smoke.mjs",
    "test:zoom-live": "node tools/zoom-live-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
