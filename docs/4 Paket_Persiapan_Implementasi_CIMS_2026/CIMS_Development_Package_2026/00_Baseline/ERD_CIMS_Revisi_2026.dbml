// CIMS Revisi 2026 - Logical Data Model
// Development baseline, not production DDL

Table organizations {
  id bigint [pk]
  name varchar
  type varchar
  status varchar
}

Table organization_units {
  id bigint [pk]
  organization_id bigint [ref: > organizations.id]
  name varchar
  jurisdiction varchar
  status varchar
}

Table users {
  id bigint [pk]
  organization_unit_id bigint [ref: > organization_units.id]
  name varchar
  email varchar [unique]
  status varchar
  mfa_required boolean
  created_at timestamp
}

Table roles {
  id bigint [pk]
  code varchar [unique]
  name varchar
}

Table permissions {
  id bigint [pk]
  code varchar [unique]
  name varchar
}

Table user_roles {
  user_id bigint [ref: > users.id]
  role_id bigint [ref: > roles.id]
  valid_from timestamp
  valid_to timestamp
}

Table delegations {
  id bigint [pk]
  grantor_user_id varchar
  grantee_user_id varchar
  scope varchar
  valid_to varchar
}

Table liaison_officers {
  id bigint [pk]
  organization_unit_id varchar
  user_id varchar
  effective_dates varchar
}

Table cases {
  id bigint [pk]
  case_number varchar
  case_type varchar
  court_unit_id bigint [ref: > organization_units.id]
  status varchar
  created_at timestamp
}

Table official_system_refs {
  id bigint [pk]
  case_id bigint [ref: > cases.id]
  system_code varchar
  external_id varchar
  url text
  last_synced_at timestamp
}

Table case_parties {
  id bigint [pk]
  case_id bigint [ref: > cases.id]
  party_type varchar
  name varchar
  contact_ref text
  confidentiality_level varchar
}

Table electronic_hearing_requests {
  id bigint [pk]
  case_id bigint [ref: > cases.id]
  request_type varchar
  reasons text
  requested_by bigint [ref: > users.id]
  status varchar
  created_at timestamp
}

Table judicial_determinations {
  id bigint [pk]
  request_id bigint [ref: > electronic_hearing_requests.id]
  decision varchar
  mode varchar
  reasons text
  document_ref text
  hash varchar
  effective_at timestamp
  issued_by bigint [ref: > users.id]
}

Table hearings {
  id bigint [pk]
  case_id bigint [ref: > cases.id]
  determination_id bigint [ref: > judicial_determinations.id]
  hearing_type varchar
  state varchar
  current_schedule_id bigint
  created_at timestamp
}

Table hearing_schedules {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  version_no int
  start_at timestamp
  end_at timestamp
  timezone varchar
  status varchar
  created_by bigint [ref: > users.id]
}

Table schedule_constraints {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  resource_type varchar
  resource_id varchar
  constraint_type varchar
  required boolean
}

Table schedule_conflicts {
  id bigint [pk]
  schedule_id bigint [ref: > hearing_schedules.id]
  conflict_type varchar
  resource_ref varchar
  details jsonb
  resolution text
}

Table schedule_approvals {
  id bigint [pk]
  schedule_id bigint [ref: > hearing_schedules.id]
  approver_id bigint [ref: > users.id]
  decision varchar
  reason text
  decided_at timestamp
}

Table reschedules {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  old_schedule_id bigint [ref: > hearing_schedules.id]
  new_schedule_id bigint [ref: > hearing_schedules.id]
  reason text
  basis_ref text
  approved_by bigint [ref: > users.id]
}

Table official_notices {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  notice_type varchar
  document_ref text
  sender_unit_id bigint [ref: > organization_units.id]
  sent_at timestamp
}

Table notice_recipients {
  id bigint [pk]
  notice_id bigint [ref: > official_notices.id]
  party_id bigint
  user_id bigint
  channel varchar
  due_at timestamp
}

Table delivery_attempts {
  id bigint [pk]
  recipient_id bigint [ref: > notice_recipients.id]
  provider varchar
  sent_at timestamp
  status varchar
  proof_ref text
}

Table acknowledgments {
  id bigint [pk]
  recipient_id bigint [ref: > notice_recipients.id]
  acknowledged_by bigint [ref: > users.id]
  acknowledged_at timestamp
  method varchar
}

Table readiness_checklists {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  location_id varchar
  checklist_type varchar
  status varchar
}

Table readiness_items {
  id bigint [pk]
  checklist_id bigint [ref: > readiness_checklists.id]
  item_code varchar
  required boolean
  status varchar
  evidence_ref text
  verified_by bigint [ref: > users.id]
}

Table technical_tests {
  id bigint [pk]
  checklist_id bigint [ref: > readiness_checklists.id]
  test_type varchar
  result varchar
  metrics jsonb
  tested_by bigint [ref: > users.id]
  tested_at timestamp
}

Table virtual_room_providers {
  id bigint [pk]
  code varchar [unique]
  name varchar
  config_ref text
  status varchar
}

Table virtual_sessions {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  provider_id bigint [ref: > virtual_room_providers.id]
  external_meeting_id varchar
  state varchar
  host_secret_ref text
  created_at timestamp
}

Table virtual_rooms {
  id bigint [pk]
  session_id bigint [ref: > virtual_sessions.id]
  room_type varchar
  external_room_id varchar
  recording_policy varchar
}

Table join_tokens {
  id bigint [pk]
  session_id bigint [ref: > virtual_sessions.id]
  participant_id bigint
  role varchar
  token_hash varchar
  expires_at timestamp
  used_at timestamp
}

Table room_assignments {
  id bigint [pk]
  room_id bigint [ref: > virtual_rooms.id]
  participant_id bigint
  valid_from timestamp
  valid_to timestamp
}

Table provider_events {
  id bigint [pk]
  session_id bigint [ref: > virtual_sessions.id]
  event_type varchar
  payload_hash varchar
  occurred_at timestamp
}

Table attendance {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  participant_id bigint
  join_at timestamp
  leave_at timestamp
  verification_status varchar
}

Table hearing_events {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  event_type varchar
  actor_id bigint [ref: > users.id]
  occurred_at timestamp
  reason text
  correlation_id uuid
}

Table identity_verifications {
  id bigint [pk]
  hearing_id varchar
  participant_id varchar
  method varchar
  result varchar
  verified_by varchar
}

Table participant_locations {
  id bigint [pk]
  hearing_id varchar
  participant_id varchar
  location_type varchar
  determination_ref varchar
}

Table room_inspections {
  id bigint [pk]
  hearing_id varchar
  location_id varchar
  sterile varchar
  camera_view varchar
  inspector_id varchar
}

Table incidents {
  id bigint [pk]
  hearing_id bigint [ref: > hearings.id]
  category varchar
  severity varchar
  detected_at timestamp
  state varchar
}

Table technical_incidents {
  incident_id bigint [pk, ref: > incidents.id]
  component varchar
  recovery_action text
}

Table cyber_incidents {
  incident_id bigint [pk, ref: > incidents.id]
  data_impact text
  notification_deadline timestamp
}

Table force_majeure_events {
  incident_id bigint [pk, ref: > incidents.id]
  evidence_ref text
  notice_deadline timestamp
}

Table incident_notifications {
  id bigint [pk]
  incident_id varchar
  recipient_unit_id varchar
  sent_at varchar
  ack_at varchar
}

Table appeal_decision_readings {
  id bigint [pk]
  case_id varchar
  determination_ref varchar
  reading_at varchar
  mode varchar
  status varchar
}

Table decision_notifications {
  id bigint [pk]
  reading_id varchar
  recipient_type varchar
  delivery_status varchar
  ack_at varchar
}

Table excerpt_publications {
  id bigint [pk]
  reading_id varchar
  published_at varchar
  official_ref varchar
}

Table case_file_transmissions {
  id bigint [pk]
  reading_id varchar
  sent_at varchar
  received_at varchar
  official_ref varchar
}

Table cassation_deadlines {
  id bigint [pk]
  reading_id varchar
  starts_at varchar
  deadline_at varchar
  basis varchar
}

Table documents {
  id bigint [pk]
  case_id varchar
  document_type varchar
  official_ref varchar
  classification varchar
}

Table document_hashes {
  id bigint [pk]
  document_id varchar
  algorithm varchar
  hash_value varchar
  timestamp_ref varchar
}

Table recordings {
  id bigint [pk]
  hearing_id varchar
  official_ref varchar
  hash varchar
  retention_policy_id varchar
}

Table retention_policies {
  id bigint [pk]
  data_class varchar
  retention_period varchar
  disposal_rule varchar
}

Table audit_logs {
  id bigint [pk]
  actor_id bigint [ref: > users.id]
  action varchar
  object_type varchar
  object_id bigint
  reason text
  correlation_id uuid
  before_value jsonb
  after_value jsonb
  created_at timestamp
}
