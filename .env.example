NODE_ENV=development
CIMS_PROCESS_ROLE=API
API_PORT=3000
WEB_ORIGINS=http://localhost:5173
AUTH_MODE=DEV
OIDC_ISSUER=
OIDC_AUDIENCE=cims-api
OIDC_JWKS_URL=

# Persistence
PERSISTENCE_MODE=MEMORY
DATABASE_URL=postgresql://cims:cims@localhost:5432/cims
DATABASE_URL_FILE=
DB_POOL_MIN=0
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_APPLICATION_NAME=cims-api
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# API security and observability
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
REQUEST_BODY_LIMIT_BYTES=1048576
TRUST_PROXY=false
SWAGGER_ENABLED=true
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_SHARED_SECRET=replace-with-secret-manager-value
WEBHOOK_SHARED_SECRET_FILE=
TOKEN_PEPPER=replace-with-secret-manager-value
TOKEN_PEPPER_FILE=
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
FIELD_ENCRYPTION_KEY_FILE=
AUDIT_HASH_KEY=replace-with-secret-manager-value
AUDIT_HASH_KEY_FILE=

# Transactional outbox worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8

# Official notification delivery
NOTIFICATION_GATEWAY_MODE=MOCK
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_API_KEY=
NOTIFICATION_GATEWAY_API_KEY_FILE=
NOTIFICATION_GATEWAY_TIMEOUT_MS=10000

# Brevo and WhatsApp
BREVO_API_KEY=your_production_brevo_key_here
WHATSAPP_PROVIDER_MODE=HTTP

# Official-system reconciliation
OFFICIAL_SYSTEM_GATEWAY_MODE=MOCK
OFFICIAL_SYSTEM_GATEWAY_URL=
OFFICIAL_SYSTEM_GATEWAY_API_KEY=
OFFICIAL_SYSTEM_GATEWAY_API_KEY_FILE=
OFFICIAL_SYSTEM_GATEWAY_TIMEOUT_MS=10000

# Video provider adapter
VIDEO_PROVIDER_MODE=MOCK
VIDEO_PROVIDER_URL=http://localhost:3010

# Zoom provider service v0.17
ZOOM_ACCOUNT_ID=
ZOOM_ACCOUNT_ID_FILE=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_ID_FILE=
ZOOM_CLIENT_SECRET=
ZOOM_CLIENT_SECRET_FILE=
ZOOM_HOST_USER_ID=
ZOOM_HOST_USER_ID_FILE=
ZOOM_API_TIMEOUT_MS=15000
ZOOM_DB_POOL_MAX=3
ZOOM_DB_CONNECT_TIMEOUT_MS=5000
ZOOM_DB_STATEMENT_TIMEOUT_MS=20000
VIDEO_PROVIDER_TIMEOUT_MS=15000

# Manual hearing intake and future database import
HEARING_IMPORT_ENABLED=false
HEARING_IMPORT_ADAPTER=DISABLED
HEARING_IMPORT_READ_ONLY=true
HEARING_IMPORT_DATABASE_URL_FILE=
HEARING_IMPORT_CONNECTION_SECRET_REFERENCE=
HEARING_IMPORT_BATCH_SIZE=100
HEARING_IMPORT_TIMEOUT_MS=15000

# Production governance and dependency resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000
LEGAL_HOLD_MAKER_CHECKER=true
RETENTION_EXECUTION_ENABLED=false

# Evidence package storage
EVIDENCE_STORAGE_MODE=LOCAL
EVIDENCE_LOCAL_DIR=/tmp/cims-evidence
EVIDENCE_STORAGE_URL=
EVIDENCE_STORAGE_API_KEY=
EVIDENCE_STORAGE_API_KEY_FILE=
EVIDENCE_STORAGE_TIMEOUT_MS=15000

# Production Observability
METRICS_BEARER_TOKEN=16_char_secure_random_string_here
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
