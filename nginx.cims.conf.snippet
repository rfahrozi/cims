    # ==========================================================
    # ROUTING CIMS (PRODUCTION)
    # Target Ports:
    # 4000: Frontend Web SPA
    # 4001: Backend API
    # 4002: Zoom Provider (Webhook)
    # ==========================================================

    # 1. Routing Backend API CIMS
    location /cims/api/ {
        proxy_pass http://127.0.0.1:4001/api/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support untuk SSE / Socket jika ada
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
    }

    # 2. Routing Zoom Webhook Ingestion (Bila zoom memanggil webhook endpoint)
    location /cims/webhooks/zoom {
        proxy_pass http://127.0.0.1:4002/webhooks/zoom;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Routing Frontend CIMS (React SPA)
    # Redirect root /cims to /cims/
    location = /cims {
        return 301 /cims/;
    }

    location /cims/ {
        proxy_pass http://127.0.0.1:4000/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
